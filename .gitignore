# ==========================================
# Tiko QAMS - .gitignore
# ==========================================

# --- Entorno, Secretos y Credenciales ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Mantener ejemplos de variables de entorno
!*.env.example
!.env.example

# --- Backups y Volúmenes de Base de Datos ---
backups/
*.sql
*.dump
*.tar
*.bak
*.rdb

# --- Docker ---
docker-compose.override.yml
.docker/

# --- Logs y Trazas ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Frontend & Node.js ---
node_modules/
dist/
build/
out/
.next/
.nuxt/
.vite/
.turbo/
.cache/
.parcel-cache/
.eslintcache

# --- Backend (.NET / C#) ---
bin/
obj/
[Bb]in/
[Oo]bj/
*.suo
*.user
*.userosscache
*.sln.docstates
TestResults/
packages/
publish/

# --- Backend (Python / Servicios secundarios) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# --- Certificados y Claves Privadas ---
**/certs/
*.crt
*.key
*.pem
*.pfx
*.p12
*.cer
*.csr

# --- IDEs y Editores de Código ---
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# VS Code (se ignoran archivos temporales, se mantienen configuraciones de equipo)
.vscode/
*.code-workspace
.history/

# --- Archivos del Sistema Operativo ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
